{
  "name": "respira",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev:mobile": "turbo run dev --filter=mobile",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run generate --filter=@respira/database",
    "db:migrate": "turbo run migrate --filter=@respira/database",
    "db:push": "turbo run push --filter=@respira/database",
    "db:studio": "turbo run studio --filter=@respira/database",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
