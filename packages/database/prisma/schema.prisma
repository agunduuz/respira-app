// Respira — çekirdek veri modeli
// Kaynak: docs/02-VERI-MODELI-VE-GUVENLIK.md
//
// Özelliklere ait modeller (EyeStrainSettings, NutritionProfile, MealEntry,
// PostureProfile, WaterGoal, StressProfile ...) ilgili özellik dosyalarında
// (docs/03-... — docs/07-...) tanımlı. O özellik geliştirilirken hem modeli
// hem de aşağıdaki User modelindeki yorum satırına alınmış ilişkiyi aç.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- ÇEKİRDEK ----------

model User {
  id        String   @id @default(uuid())
  authId    String   @unique // Supabase auth.users.id ile eşleşir
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// docs/02 saklama kuralı: favoriye eklenmemiş kayıtların ham içeriği bu
  /// süre sonunda temizlenir; sayısal metrikler kalır. Kullanıcı ayarlardan
  /// değiştirebilir, varsayılan 30 gün.
  dataRetentionDays Int @default(30)

  consents          ConsentRecord[]
  notificationPrefs NotificationPreference[]
  dailyReports      DailyReport[]

  eyeStrainSettings EyeStrainSettings?
  eyeStrainSessions EyeStrainSession[]

  nutritionProfile NutritionProfile?
  mealEntries      MealEntry[]
  dailyNutrition   DailyNutritionSummary[]

  postureProfile   PostureProfile?
  postureBreakLogs PostureBreakLog[]

  // --- Özellik ilişkileri (ilgili özellik geliştirilince açılacak) ---
  // waterGoal         WaterGoal?              // docs/06
  // waterLogs         WaterIntakeLog[]        // docs/06
  // stressProfile     StressProfile?          // docs/07
  // breathingSessions BreathingSession[]      // docs/07

  @@map("users")
}

// KVKK: her açık rıza kaydı ayrı bir satır — hangi metne, ne zaman, hangi
// sürüme onay verildiği kanıtlanabilir olmalı (KVKK md. 6, açık rıza ispatı)
model ConsentRecord {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType ConsentType
  textVersion String // örn. "aydinlatma-v1.2"
  grantedAt   DateTime    @default(now())
  revokedAt   DateTime?

  @@index([userId, consentType])
  @@map("consent_records")
}

enum ConsentType {
  AYDINLATMA_METNI // genel KVKK aydınlatma
  OZEL_NITELIKLI_VERI_RIZASI // sağlık verisi işleme açık rızası
  BILDIRIM_IZNI_GOZ
  BILDIRIM_IZNI_OGUN
  BILDIRIM_IZNI_KAN_TAHLILI
  BILDIRIM_IZNI_POSTUR
  BILDIRIM_IZNI_SU
  BILDIRIM_IZNI_STRES
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         String // "eye_strain" | "water" | "posture" | "stress" | "blood_test"
  enabled          Boolean  @default(false)
  frequencyMinutes Int?
  quietHoursStart  String? // "22:00"
  quietHoursEnd    String? // "08:00"
  updatedAt        DateTime @updatedAt

  @@unique([userId, category])
  @@map("notification_preferences")
}

// Tüm özelliklerin günlük özetini tek yerde toplayan çapraz-özellik tablo
model DailyReport {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  isFavorite Boolean  @default(false)

  // isFavorite=false ise, ilgili günün ham içerik detayları (öğün metinleri vb.)
  // periyodik bir temizlik işiyle silinir; sadece bu tablodaki özet metrikler kalır.
  eyeStrainComplianceRate Float?
  totalWaterMl            Int?
  totalCalories           Int?
  totalProteinG           Float?
  totalCarbsG             Float?
  totalFatG               Float?
  postureBreaksTaken      Int?
  stressSessionsCompleted Int?

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("daily_reports")
}

// ---------- GÖZ YORGUNLUĞU (docs/03) ----------

model EyeStrainSettings {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  intervalMinutes Int      @default(20)
  breakSeconds    Int      @default(20)
  updatedAt       DateTime @updatedAt

  @@map("eye_strain_settings")
}

model EyeStrainSession {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggeredAt DateTime        @default(now())
  status      EyeStrainStatus

  // Ağ tekrarı aynı molayı iki kez yazmasın: iki gerçek mola aynı milisaniyede
  // tetiklenemez, bu yüzden kısıt güvenli ve gönderimi idempotent yapıyor.
  @@unique([userId, triggeredAt])
  // Analiz sorguları hep "bu kullanıcının şu tarih aralığındaki seansları"
  // şeklinde — bileşik indeks bunu karşılıyor.
  @@index([userId, triggeredAt])
  @@map("eye_strain_sessions")
}

enum EyeStrainStatus {
  COMPLETED
  SKIPPED
  MISSED // bildirime hiç yanıt verilmedi
}

// ---------- BESLENME / KAN ŞEKERİ (docs/04) ----------

model NutritionProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Adım 1 — öğün düzeni
  mealsPerDay Int
  mealTimes   Json? // [{ label: "Kahvaltı", time: "08:00" }, ...]

  // Adım 2 — fiziksel profil
  age               Int
  heightCm          Float
  weightKg          Float
  // Mifflin-St Jeor sabiti cinsiyete göre değişiyor (E +5 / K −161).
  // Opsiyonel: belirtilmezse iki sabitin ortalaması kullanılır (bkz.
  // packages/shared-types/src/nutrition-math.ts).
  biologicalSex     BiologicalSex?
  trainingFrequency TrainingFrequency
  trainingType      String
  bodyGoal          BodyGoal
  bodyFatPercent    Float?
  measurements      Json? // { neck, arm, waist, hip }

  // Adım 3 — makro hedefleri
  targetCalories   Int
  targetProteinG   Float
  targetCarbsG     Float
  targetFatG       Float
  // Kullanıcı önerilen değerleri elle değiştirdiyse true; profil verisi
  // değişse bile hedefleri sessizce ezmemek için buna bakılır.
  macrosCustomized Boolean @default(false)

  // Adım 4 — sağlık bilgileri (hepsi opsiyonel, KVKK veri asgarileştirmesi)
  bloodType               String?
  sugarNeedRate           String?
  lastBloodTestDate       DateTime?
  bloodTestReminderMonths Int?

  updatedAt DateTime @updatedAt

  @@map("nutrition_profiles")
}

enum BiologicalSex {
  MALE
  FEMALE
}

enum TrainingFrequency {
  NEVER
  ONE_TO_TWO
  TWO_TO_THREE
  FOUR_TO_FIVE
  DAILY
}

enum BodyGoal {
  ATHLETIC
  MUSCLE_GAIN
  WEIGHT_LOSS
  MAINTENANCE
  FAT_LOSS
}

model MealEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  mealLabel String // "Kahvaltı", "Öğle", vb.
  mode      MealMode

  // SIMPLE modda yalnızca rawText dolu; DETAILED modda foodItemsDetail ve
  // sayısal alanlar da dolu olur. docs/04: basit modda besin değeri hesabı
  // YAPILMAZ — bu yüzden sayısal alanlar nullable.
  rawText         String?
  foodItemsDetail Json? // [{ name, amount, unit, calories, protein, carbs, fat, fiber }]
  calories        Int?
  proteinG        Float?
  carbsG          Float?
  fatG            Float?
  fiberG          Float?

  // docs/02 saklama kuralı: favori olmayan kayıtların ham içeriği (rawText,
  // foodItemsDetail) süre sonunda temizlenir; sayısal metrikler kalır.
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, date])
  @@map("meal_entries")
}

enum MealMode {
  SIMPLE
  DETAILED
}

model DailyNutritionSummary {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @db.Date
  totalCalories Int
  totalProteinG Float
  totalCarbsG   Float
  totalFatG     Float
  totalFiberG   Float

  @@unique([userId, date])
  @@map("daily_nutrition_summaries")
}

// ---------- POSTÜR / ERGONOMİ (docs/05) ----------

model PostureProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workStyle         WorkStyle
  workIntensity     WorkIntensity
  screenHoursPerDay Int?
  occupationType    String

  /// Saat başı kendine ayırabileceği dakika — egzersiz seti bu süreye
  /// göre seçiliyor (docs/05 egzersiz üretim mantığı).
  minutesPerHourAvailable Int

  /// Mesai saatleri. Bildirimler yalnızca bu aralıkta gönderilir; dışarısı
  /// sessiz saat olarak ele alınıyor (docs/05 + docs/08).
  workHoursStart String? // "09:00"
  workHoursEnd   String? // "18:00"

  updatedAt DateTime @updatedAt

  @@map("posture_profiles")
}

enum WorkStyle {
  SEDENTARY
  STANDING_ACTIVE
  MIXED
}

enum WorkIntensity {
  LIGHT
  MODERATE
  HEAVY
}

model PostureBreakLog {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggeredAt   DateTime    @default(now())
  status        BreakStatus
  /// Hangi egzersiz seti önerildi — set tanımları kodda
  /// (packages/shared-types/src/posture-exercises.ts).
  exerciseSetId String?

  @@unique([userId, triggeredAt])
  @@index([userId, triggeredAt])
  @@map("posture_break_logs")
}

enum BreakStatus {
  COMPLETED
  SKIPPED
  MISSED
}
